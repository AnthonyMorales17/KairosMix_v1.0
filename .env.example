# Copy to .env and set unique private values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kairosmix_db?schema=public"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
GEMINI_API_KEY=""
USDA_API_KEY=""

# Required only when creating demo users with the seed script.
SEED_ADMIN_PASSWORD=""
SEED_VENDOR_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# Required if using the PostgreSQL service in infra/docker-compose.yml.
POSTGRES_USER="kairos_admin"
POSTGRES_PASSWORD=""
POSTGRES_DB="kairosmix_db"
